# Copy to .env and fill in your Azure AI Foundry details.
#   Copy-Item .env.example .env     (run-local.ps1 does this for you)
#
# The simulation is fully deterministic WITHOUT an LLM, so you can leave these
# blank and run the whole tournament offline. Set WC_LLM_ENABLED=true and the
# AI Foundry values below to enable model-backed commentary/flavour.

# --- Azure AI Foundry / Azure OpenAI ---------------------------------------
WC_LLM_ENABLED=false

# Endpoint. Two forms are auto-detected:
#   v1 (Foundry, needed for gpt-5-class):  https://<res>.openai.azure.com/openai/v1
#   classic:                               https://<res>.openai.azure.com
WC_AOAI_ENDPOINT=

# API key auth (from portal -> Keys and Endpoint). Leave BLANK to use Entra ID.
WC_AOAI_API_KEY=

# The *deployment name* of your model in Foundry (not the base model id).
WC_AOAI_DEPLOYMENT=gpt-4o

# API version. Use "preview" for the v1 endpoint; a dated version for classic.
WC_AOAI_API_VERSION=preview

# --- Worker tuning ----------------------------------------------------------
WC_WORKER_CONCURRENCY=4

# --- Corporate network: proxy + TLS inspection ------------------------------
# If your office blocks/inspects outbound HTTPS, the api/worker containers cannot
# reach Azure ("Failed to fetch" / connection errors). These lines are read by the
# Python HTTP client (httpx) automatically.
#
# 1) Office HTTP/HTTPS proxy (ask IT for host:port; include user:pass if required):
# HTTPS_PROXY=http://user:pass@proxy.corp.example:8080
# HTTP_PROXY=http://user:pass@proxy.corp.example:8080
# NO_PROXY=localhost,127.0.0.1,redis,postgres,azurite,api
#
# 2) If the proxy does TLS inspection (its own CA), point the client at that CA.
#    Put corp-ca.pem next to docker-compose.yml and uncomment the volume +
#    SSL_CERT_FILE line in docker-compose.yml's api/worker services.
# SSL_CERT_FILE=/certs/corp-ca.pem
